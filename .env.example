# Copy to .env. Enter your own PostgreSQL credentials; never commit .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=document_checker
PGUSER=document_checker
PGPASSWORD=
# Alternatively set DATABASE_URL=postgresql+psycopg://user:encoded_password@localhost:5432/document_checker
# Separate PG* fields support passwords containing @, :, / without URL escaping.
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=20
MAX_PAGES=200
MAX_CHUNKS=2000
MAX_REFERENCE_CHUNKS=10000
CHUNK_CHARS=700
# Semantic mode is optional. Install requirements.txt before enabling it.
ENABLE_SEMANTIC=false
SEMANTIC_MODEL=keepitreal/vietnamese-sbert
# Ngưỡng khởi đầu từ evaluation/results/REPORT.md; đo lại khi có dữ liệu thật.
# Chế độ từ vựng (so khớp cụm 4 từ liên tiếp, app/services/shingles.py): điểm = tỷ lệ số từ của đoạn nằm trong cụm trùng
# nguyên văn với nguồn. 0,30 chọn trên validation của evaluation/benchmark_docs.py (dữ liệu tổng hợp); đo lại khi có dữ liệu thật.
# (Tên cũ LEXICAL_THRESHOLD dùng thang cosine 0,08 và không còn tác dụng; hãy xóa dòng đó khỏi .env.)
VERBATIM_THRESHOLD=0.30
SEMANTIC_THRESHOLD=0.68
# OCR chỉ chạy cho trang PDF không đủ text layer.
ENABLE_OCR=true
TESSERACT_CMD=tesseract
OCR_LANGUAGE=vie+eng
OCR_DPI=200
MAX_OCR_PAGES=30
OCR_PAGE_TIMEOUT=30
OCR_MIN_TEXT_CHARS=1
# Giới hạn trình bày sau khi đã gộp và khử cảnh báo trùng.
MAX_ALERTS_PER_SOURCE=1000
MAX_ALERTS_PER_REPORT=1000
# Serper Google Search API. Keep the key only in .env; never commit it or expose it to frontend.
SERPER_API_KEY=
SERPER_TIMEOUT_SECONDS=20
SERPER_MAX_RESULTS=10
SERPER_MAX_QUERIES=5
# Số từ tối thiểu trùng nguyên văn với đoạn trích tìm kiếm để coi kết quả là nghi vấn và tải toàn văn.
SERPER_MIN_WORDS=8
# Tự lưu nguồn Internet: trang web tìm thấy được tải toàn văn và lưu vào PostgreSQL (role "web"),
# dùng lại cho các lần kiểm tra sau. Cần SERPER_API_KEY. Đặt WEB_AUTO_SAVE=false để chỉ lấy đoạn trích tìm kiếm.
WEB_AUTO_SAVE=true
WEB_MAX_PAGES_PER_CHECK=6
WEB_MAX_PAGE_MB=5
WEB_FETCH_TIMEOUT_SECONDS=15
MAX_WEB_CHUNKS=20000
# Xác thực/phân quyền. Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Để trống thì mỗi lần khởi động dùng khóa ngẫu nhiên mới (mọi người dùng phải đăng nhập lại).
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Đặt true khi chạy sau HTTPS để cookie đăng nhập chỉ gửi qua kết nối an toàn.
COOKIE_SECURE=false
MIN_PASSWORD_LENGTH=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Tự đăng ký (nút "Đăng ký" ở trang chủ) chỉ tạo tài khoản NGƯỜI DÙNG (không bao giờ quản trị), chưa xác minh email.
# Đặt false nếu muốn chỉ quản trị viên cấp tài khoản. Giới hạn số lần đăng ký mỗi giờ cho mỗi địa chỉ IP.
ALLOW_REGISTRATION=true
REGISTER_MAX_PER_HOUR=30
